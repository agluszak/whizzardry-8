# Public entry points for the pinned GLM, utf8cpp and fmt dependencies.
[
  {"include": ["@[\"<]glm/detail/.*[\">]", "private", "<glm/glm.hpp>", "public"]},
  {"include": ["@[\"<]utf8/.*[\">]", "private", "<utf8.h>", "public"]},
  {"include": ["@[\"<]fmt/base\\.h[\">]", "private", "<fmt/format.h>", "public"]},
  {"include": ["@[\"<]glm/ext/matrix_clip_space\\.inl[\">]", "private", "<glm/ext/matrix_clip_space.hpp>", "public"]},
  {"include": ["@[\"<]glm/ext/matrix_transform\\.inl[\">]", "private", "<glm/ext/matrix_transform.hpp>", "public"]},
  {"include": ["@[\"<]glm/ext/quaternion_common\\.inl[\">]", "private", "<glm/ext/quaternion_common.hpp>", "public"]},
  {"include": ["@[\"<]glm/ext/quaternion_geometric\\.inl[\">]", "private", "<glm/ext/quaternion_geometric.hpp>", "public"]},
  {"include": ["@[\"<]glm/ext/quaternion_trigonometric\\.inl[\">]", "private", "<glm/ext/quaternion_trigonometric.hpp>", "public"]},
  {"include": ["@[\"<]glm/ext/scalar_constants\\.inl[\">]", "private", "<glm/ext/scalar_constants.hpp>", "public"]},
  {"include": ["@[\"<]glm/gtc/constants\\.inl[\">]", "private", "<glm/gtc/constants.hpp>", "public"]},
  {"include": ["@[\"<]glm/gtc/matrix_access\\.inl[\">]", "private", "<glm/gtc/matrix_access.hpp>", "public"]},
  {"include": ["@[\"<]glm/gtc/quaternion\\.inl[\">]", "private", "<glm/gtc/quaternion.hpp>", "public"]},
  {"include": ["@[\"<]glm/gtc/type_ptr\\.inl[\">]", "private", "<glm/gtc/type_ptr.hpp>", "public"]},
  {"include": ["@[\"<]glm/gtx/euler_angles\\.inl[\">]", "private", "<glm/gtx/euler_angles.hpp>", "public"]},
  {"include": ["@[\"<]glm/gtx/rotate_vector\\.inl[\">]", "private", "<glm/gtx/rotate_vector.hpp>", "public"]}
]
