Checks: >-
  -*,
  clang-analyzer-core.*,
  clang-analyzer-cplusplus.NewDelete*,
  clang-analyzer-unix.Malloc,
  clang-analyzer-cplusplus.InnerPointer,
  performance-unnecessary-copy-initialization,
  performance-noexcept-move-constructor,
  performance-move-const-arg,
  performance-string-view-conversions,
  performance-use-std-move,
  modernize-use-equals-default,
  modernize-use-emplace,
  modernize-use-scoped-lock,
  modernize-use-starts-ends-with,
  modernize-use-std-bit,
  modernize-use-structured-binding,
  modernize-use-string-view,
  modernize-deprecated-headers,
  readability-use-anyofallof,
  readability-redundant-smartptr-get,
  readability-duplicate-include,
  bugprone-assignment-in-selection-statement,
  bugprone-suspicious-stringview-data-usage,
  bugprone-virtual-near-miss,
  bugprone-suspicious-memset-usage,
  bugprone-sizeof-container,
  bugprone-branch-clone,
  bugprone-dangling-handle,
  bugprone-sizeof-expression,
  bugprone-undefined-memory-manipulation,
  bugprone-unused-raii,
  bugprone-use-after-move,
  bugprone-suspicious-include,
  bugprone-derived-method-shadowing-base-method,
  bugprone-invalid-enum-default-initialization,
  bugprone-missing-end-comparison,
  cppcoreguidelines-virtual-class-destructor,
  misc-uniqueptr-reset-release,
  misc-include-cleaner,
  misc-header-include-cycle,
  misc-static-initialization-cycle
WarningsAsErrors: '*'
HeaderFilterRegex: '(^|/)(include|src|tests|tools)/'
ExcludeHeaderFilterRegex: '(^|/)(build[^/]*|vendor)/'
SystemHeaders: false
InheritParentConfig: false
CheckOptions:
  bugprone-unchecked-optional-access.IgnoreValueCalls: 'true'
  misc-header-include-cycle.IgnoredFilesList: '(^|/)_deps/'
