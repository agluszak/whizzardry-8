Checks: >-
  -*,
  misc-include-cleaner,
  misc-header-include-cycle,
  readability-duplicate-include,
  bugprone-suspicious-include,
  modernize-deprecated-headers
WarningsAsErrors: >-
  misc-include-cleaner,
  misc-header-include-cycle,
  readability-duplicate-include,
  bugprone-suspicious-include,
  modernize-deprecated-headers
HeaderFilterRegex: '(^|/)(include|src|tests)/'
ExcludeHeaderFilterRegex: '(^|/)(build[^/]*|vendor)/'
SystemHeaders: false
InheritParentConfig: false
CheckOptions:
  # Check project include cycles, not implementation cycles in fetched libraries.
  misc-header-include-cycle.IgnoredFilesList: '(^|/)_deps/'
